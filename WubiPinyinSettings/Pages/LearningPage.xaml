<Page
    x:Class="WubiPinyinSettings.LearningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    FontFamily="{StaticResource SettingsCjkFontFamily}"
    Loaded="Page_Loaded">
  <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="760" Padding="28,20,28,32" Spacing="18">
      <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="学习与隐私" />
      <controls:InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" />

      <StackPanel>
        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="本地学习" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
          <StackPanel Spacing="12">
            <ToggleSwitch x:Name="LearningToggle" Header="学习选词排序" Toggled="Settings_Changed" />
            <Button HorizontalAlignment="Left" Content="重置学习数据" Click="ResetLearning_Click" />
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel>
        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="密码输入" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
          <ToggleSwitch x:Name="PasswordProtectionToggle" Header="保护密码输入框" Toggled="Settings_Changed" />
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
