<Page
    x:Class="WubiPinyinSettings.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    FontFamily="{StaticResource SettingsCjkFontFamily}"
    Loaded="Page_Loaded">
  <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="760" Padding="28,20,28,32" Spacing="18">
      <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="外观" />
      <controls:InfoBar x:Name="StatusBar" IsClosable="False" IsOpen="False" />

      <StackPanel>
        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="候选窗" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
          <StackPanel Spacing="12">
            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Text="外观模式" />
              <ComboBox x:Name="ThemeBox" Grid.Column="1" MinWidth="180" SelectionChanged="Theme_Changed">
                <ComboBoxItem Content="跟随系统" Tag="system" />
                <ComboBoxItem Content="浅色" Tag="light" />
                <ComboBoxItem Content="深色" Tag="dark" />
              </ComboBox>
            </Grid>
            <ToggleSwitch x:Name="SourceLabelsToggle" Header="显示候选来源" Toggled="SourceLabels_Toggled" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
