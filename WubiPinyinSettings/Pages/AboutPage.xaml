<Page
    x:Class="WubiPinyinSettings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="720" Padding="32,20,32,36" Spacing="24">
      <StackPanel Spacing="4">
        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="五笔·拼音" />
        <TextBlock Style="{StaticResource SettingsSecondaryTextStyle}" Text="Windows 11 MVP" />
      </StackPanel>

      <StackPanel>
        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="关于" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
          <StackPanel Spacing="12">
            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Text="版本" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsSecondaryTextStyle}" Text="MVP" />
            </Grid>
            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Text="数据位置" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SettingsSecondaryTextStyle}" Text="%AppData%\WubiPinyin" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel>
        <TextBlock Style="{StaticResource SettingsSectionTitleStyle}" Text="许可" />
        <Border Style="{StaticResource SettingsGroupBorderStyle}">
          <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsSecondaryTextStyle}" Text="本项目遵循 GPLv3 派生路线。" />
            <HyperlinkButton Content="Rime / Weasel 许可证与归属" NavigateUri="https://rime.im/" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
