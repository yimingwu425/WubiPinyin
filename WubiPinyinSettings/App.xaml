<Application
    x:Class="WubiPinyinSettings.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <controls:XamlControlsResources />
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="#F5F5F7" />
          <SolidColorBrush x:Key="SettingsGroupBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SettingsGroupBorderBrush" Color="#D8D8DC" />
          <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#66666B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="#202124" />
          <SolidColorBrush x:Key="SettingsGroupBackgroundBrush" Color="#2A2B2E" />
          <SolidColorBrush x:Key="SettingsGroupBorderBrush" Color="#494A4E" />
          <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#B6B6BB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="SettingsWindowBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="SettingsGroupBackgroundBrush" Color="Transparent" />
          <SolidColorBrush x:Key="SettingsGroupBorderBrush" Color="#FFFFFFFF" />
          <SolidColorBrush x:Key="SettingsMutedTextBrush" Color="#FFFFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="SettingsFontFamily">Segoe UI Variable</FontFamily>
      <FontFamily x:Key="SettingsCjkFontFamily">Microsoft YaHei UI</FontFamily>
      <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SettingsCjkFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SettingsCjkFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="SettingsSecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SettingsCjkFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource SettingsMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SettingsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SettingsGroupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SettingsGroupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
      </Style>
      <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="44" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
