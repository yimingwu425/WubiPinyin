+#include <rime/context.h>
+#include <rime/dict/vocabulary.h>
+#include <rime/engine.h>
+#include <rime/language.h>
+#include <rime/schema.h>
+#include <rime/translation.h>
+#include <rime/gear/hybrid_filter.h>
+#include <rime/gear/translator_commons.h>
+
+using namespace rime;
+
+namespace {
+
+const char kHybridFilterConfig[] = R"(
+hybrid:
+  tag: abc
+  route_options:
+    auto: hybrid_auto
+    wubi: hybrid_wubi
+    pinyin: hybrid_pinyin
+  candidate_source_masks:
+    wubi: 1
+    pinyin: 2
+  source_languages:
+    hybrid_auto_wubi: wubi
+    hybrid_auto_pinyin: pinyin
+  wubi_candidate_types: [ table, user_table ]
+  pinyin_candidate_types: [ phrase, user_phrase, sentence ]
+  deduplicate: true
+  passthrough_unclassified: true
+  ranking_window: 64
+)";
+
+class HybridFilterTestEngine : public Engine {
+ public:
+  explicit HybridFilterTestEngine(Config* config) {
+    schema_.reset(new Schema("hybrid_filter_test", config));
+  }
+};
+
+Config* MakeConfig() {
+  auto config = new Config;
+  std::istringstream stream(kHybridFilterConfig);
+  if (!config->LoadFromStream(stream)) {
+    delete config;
+    return nullptr;
+  }
+  return config;
+}
+
+an<Candidate> MakePhrase(const Language* language,
+                         const string& type,
+                         const string& text,
+                         double quality) {
+  auto entry = New<DictEntry>();
+  entry->text = text;
+  auto phrase = New<Phrase>(language, type, 0, 2, entry);
+  phrase->set_quality(quality);
+  return phrase;
+}
+
+class CountingTranslation : public FifoTranslation {
+ public:
+  bool Next() override {
+    ++next_count;
+    return FifoTranslation::Next();
+  }
+
+  size_t next_count = 0;
+};
+
+vector<of<Candidate>> Collect(an<Translation> translation,
+                              CandidateList* candidates) {
+  vector<of<Candidate>> result;
+  while (translation && !translation->exhausted()) {
+    auto candidate = translation->Peek();
+    if (candidate) {
+      result.push_back(candidate);
+      candidates->push_back(candidate);
+    }
+    translation->Next();
+  }
+  return result;
+}
+
+}  // namespace
+
+TEST(HybridFilterTest, RegistersAsAFilterComponent) {
+  EXPECT_NE(nullptr, Filter::Require("hybrid_filter"));
+}
+
+TEST(HybridFilterTest, MergesSourcesAndKeepsTheGenuineCandidate) {
+  Config* config = MakeConfig();
+  ASSERT_NE(nullptr, config);
+  the<Engine> engine(new HybridFilterTestEngine(config));
+  HybridFilter filter(Ticket(engine.get(), "hybrid"));
+
+  Language wubi("hybrid_auto_wubi");
+  Language pinyin("hybrid_auto_pinyin");
+  auto translation = New<FifoTranslation>();
+  translation->Append(MakePhrase(&wubi, "table", "同", 1.0));
+  translation->Append(MakePhrase(&pinyin, "completion", "你", 2.0));
+  translation->Append(MakePhrase(&pinyin, "phrase", "同", 3.0));
+  translation->Append(New<SimpleCandidate>("punct", 0, 2, "，"));
+
+  CandidateList candidates;
+  vector<of<Candidate>> result =
+      Collect(filter.Apply(translation, &candidates), &candidates);
+
+  ASSERT_EQ(3U, result.size());
+  auto merged = As<HybridCandidate>(result[0]);
+  ASSERT_TRUE(bool(merged));
+  EXPECT_EQ(kCandidateSourceBoth, merged->source_mask());
+  EXPECT_EQ("hybrid_both", merged->type());
+  EXPECT_DOUBLE_EQ(3.0, merged->quality());
+  EXPECT_EQ("phrase", Candidate::GetGenuineCandidate(merged)->type());
+
+  auto completion = As<HybridCandidate>(result[1]);
+  ASSERT_TRUE(bool(completion));
+  EXPECT_EQ(kCandidateSourcePinyin, completion->source_mask());
+  EXPECT_EQ("hybrid_pinyin", completion->type());
+  EXPECT_EQ("punct", result[2]->type());
+}
+
+TEST(HybridFilterTest, RouteLockFiltersOnlySourceCandidates) {
+  Config* config = MakeConfig();
+  ASSERT_NE(nullptr, config);
+  the<Engine> engine(new HybridFilterTestEngine(config));
+  engine->context()->set_option("hybrid_wubi", true);
