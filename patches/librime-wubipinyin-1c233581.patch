+//
+// Copyright RIME Developers
+// Distributed under the BSD License
+//
+
+#include <algorithm>
+#include <rime/candidate.h>
+#include <rime/config.h>
+#include <rime/context.h>
+#include <rime/engine.h>
+#include <rime/language.h>
+#include <rime/schema.h>
+#include <rime/segmentation.h>
+#include <rime/translation.h>
+#include <rime/gear/hybrid_filter.h>
+#include <rime/gear/translator_commons.h>
+
+namespace rime {
+
+namespace {
+
+CandidateSourceMask MergeSourceMasks(CandidateSourceMask left,
+                                      CandidateSourceMask right) {
+  return static_cast<CandidateSourceMask>(static_cast<uint8_t>(left) |
+                                          static_cast<uint8_t>(right));
+}
+
+CandidateSourceMask SourceMaskForName(const string& name) {
+  if (name == "wubi")
+    return kCandidateSourceWubi;
+  if (name == "pinyin")
+    return kCandidateSourcePinyin;
+  return kCandidateSourceNone;
+}
+
+void LoadSourceTypes(Config* config,
+                     const string& path,
+                     CandidateSourceMask source_mask,
+                     map<string, CandidateSourceMask>* source_types) {
+  if (!config || !source_types)
+    return;
+  auto types = config->GetList(path);
+  if (!types)
+    return;
+  for (auto iter = types->begin(); iter != types->end(); ++iter) {
+    auto type = As<ConfigValue>(*iter);
+    if (!type)
+      continue;
+    (*source_types)[type->str()] = MergeSourceMasks(
+        (*source_types)[type->str()], source_mask);
+  }
+}
+
+}  // namespace
+
+const char* HybridCandidate::TypeForSourceMask(
+    CandidateSourceMask source_mask) {
+  switch (source_mask) {
+    case kCandidateSourceWubi:
+      return "hybrid_wubi";
+    case kCandidateSourcePinyin:
+      return "hybrid_pinyin";
+    case kCandidateSourceBoth:
+      return "hybrid_both";
+    default:
+      return "hybrid_unknown";
+  }
+}
+
+HybridCandidate::HybridCandidate(const an<Candidate>& item,
+                                 CandidateSourceMask source_mask)
+    : UniquifiedCandidate(item, TypeForSourceMask(source_mask)),
+      source_mask_(source_mask) {}
+
+void HybridCandidate::AddSourceMask(CandidateSourceMask source_mask) {
+  source_mask_ = MergeSourceMasks(source_mask_, source_mask);
+  set_type(TypeForSourceMask(source_mask_));
+}
+
+class HybridFilterTranslation : public PrefetchTranslation {
+ public:
+  HybridFilterTranslation(an<Translation> translation, HybridFilter* filter)
+      : PrefetchTranslation(translation),
+        filter_(filter),
+        next_order_(filter->ranking_window_) {
+    BuildInitialWindow();
+  }
+
+ private:
+  struct SourceCandidate {
+    an<Candidate> candidate;
+    CandidateSourceMask source_mask;
+  };
+
+  struct SourceEntry {
+    vector<SourceCandidate> candidates;
+    CandidateSourceMask source_mask = kCandidateSourceNone;
+    size_t order = 0;
+    an<HybridCandidate> output;
+  };
+
+  struct RankedCandidate {
+    an<Candidate> candidate;
+    size_t order;
+    bool rankable;
+  };
+
+  an<HybridCandidate> BuildCandidate(const SourceEntry& entry) {
+    if (!filter_->Accepts(entry.source_mask))
+      return nullptr;
+
+    CandidateSourceMask required = filter_->RequiredSourceMask();
+    size_t primary_index = entry.candidates.size();
+    for (size_t i = 0; i < entry.candidates.size(); ++i) {
+      const auto& current = entry.candidates[i];
+      if (!current.candidate ||
+          (required != kCandidateSourceNone &&
+           (static_cast<uint8_t>(current.source_mask) &
+            static_cast<uint8_t>(required)) == 0)) {
+        continue;
+      }
+      if (primary_index == entry.candidates.size() ||
+          current.candidate->compare(
+              *entry.candidates[primary_index].candidate) < 0) {
+        primary_index = i;
+      }
+    }
+    if (primary_index == entry.candidates.size())
+      return nullptr;
+
+    auto hybrid = New<HybridCandidate>(entry.candidates[primary_index].candidate,
+                                       entry.source_mask);
+    for (size_t i = 0; i < entry.candidates.size(); ++i) {
+      if (i != primary_index)
+        hybrid->Append(entry.candidates[i].candidate);
+    }
+    hybrid->set_quality(entry.candidates[primary_index].candidate->quality());
+    return hybrid;
+  }
+
+  size_t FindOrCreateEntry(const an<Candidate>& candidate, size_t order) {
+    size_t entry_index = source_entries_.size();
+    if (filter_->deduplicate_) {
+      auto existing = source_entry_indices_.find(candidate->text());
+      if (existing != source_entry_indices_.end()) {
+        entry_index = existing->second;
+      }
+    }
+    if (entry_index == source_entries_.size()) {
+      source_entries_.push_back({{}, kCandidateSourceNone, order, nullptr});
+      if (filter_->deduplicate_) {
+        source_entry_indices_[candidate->text()] = entry_index;
+      }
+    }
+    return entry_index;
+  }
+
+  void AddSourceCandidate(SourceEntry* entry,
+                          const an<Candidate>& candidate,
+                          CandidateSourceMask source_mask) {
+    entry->candidates.push_back({candidate, source_mask});
+    entry->source_mask = MergeSourceMasks(entry->source_mask, source_mask);
+    if (entry->output) {
+      entry->output->Append(candidate);
+      entry->output->AddSourceMask(source_mask);
+    }
+  }
+
+  void SortInitialCandidates(vector<RankedCandidate>* ranked) {
+    std::stable_sort(
+        ranked->begin(), ranked->end(),
+        [](const RankedCandidate& left, const RankedCandidate& right) {
+          return left.order < right.order;
+        });
+    const auto compare_candidates =
+        [](const RankedCandidate& left, const RankedCandidate& right) {
+          const int comparison = left.candidate->compare(*right.candidate);
+          return comparison != 0 ? comparison < 0 : left.order < right.order;
+        };
+    auto sortable_begin = ranked->begin();
+    for (auto current = ranked->begin(); current != ranked->end(); ++current) {
+      if (current->rankable) {
+        continue;
+      }
+      std::sort(sortable_begin, current, compare_candidates);
+      sortable_begin = current + 1;
+    }
+    std::sort(sortable_begin, ranked->end(), compare_candidates);
+    for (const auto& candidate : *ranked) {
+      cache_.push_back(candidate.candidate);
+    }
+  }
+
+  void BuildInitialWindow() {
+    vector<RankedCandidate> ranked;
+
+    for (size_t order = 0;
+         translation_ && !translation_->exhausted() &&
+         order < filter_->ranking_window_;
+         ++order) {
+      auto candidate = translation_->Peek();
+      translation_->Next();
+      if (!candidate)
+        continue;
+
+      CandidateSourceMask source_mask = filter_->ClassifyCandidate(candidate);
+      if (source_mask == kCandidateSourceNone) {
+        if (filter_->passthrough_unclassified_) {
+          ranked.push_back({candidate, order, false});
+        }
+        continue;
+      }
+
+      SourceEntry& entry = source_entries_[FindOrCreateEntry(candidate, order)];
+      AddSourceCandidate(&entry, candidate, source_mask);
+    }
+
+    for (auto& entry : source_entries_) {
+      if (auto candidate = BuildCandidate(entry)) {
+        entry.output = candidate;
+        ranked.push_back({candidate, entry.order, true});
+      }
+    }
+    SortInitialCandidates(&ranked);
+    if (cache_.empty() && (!translation_ || translation_->exhausted())) {
+      set_exhausted(true);
+    }
+  }
+
+  bool Replenish() override {
+    while (translation_ && !translation_->exhausted()) {
+      const auto candidate = translation_->Peek();
+      const size_t order = next_order_++;
+      translation_->Next();
+      if (!candidate) {
+        continue;
+      }
+
+      const CandidateSourceMask source_mask =
+          filter_->ClassifyCandidate(candidate);
+      if (source_mask == kCandidateSourceNone) {
+        if (filter_->passthrough_unclassified_) {
+          cache_.push_back(candidate);
+          return true;
+        }
+        continue;
+      }
+
+      SourceEntry& entry =
+          source_entries_[FindOrCreateEntry(candidate, order)];
+      const bool was_emitted = static_cast<bool>(entry.output);
+      AddSourceCandidate(&entry, candidate, source_mask);
+      if (was_emitted) {
+        continue;
+      }
+      if (auto output = BuildCandidate(entry)) {
+        entry.output = output;
+        cache_.push_back(output);
+        return true;
+      }
+    }
+    set_exhausted(true);
+    return false;
+  }
+
+  HybridFilter* filter_;
+  vector<SourceEntry> source_entries_;
+  map<string, size_t> source_entry_indices_;
+  size_t next_order_ = 0;
+};
+
+HybridFilter::HybridFilter(const Ticket& ticket) : Filter(ticket) {
+  source_types_["table"] = kCandidateSourceWubi;
+  source_types_["user_table"] = kCandidateSourceWubi;
+  source_types_["phrase"] = kCandidateSourcePinyin;
+  source_types_["user_phrase"] = kCandidateSourcePinyin;
+  source_types_["sentence"] = kCandidateSourcePinyin;
+  source_languages_["hybrid_auto_wubi"] = kCandidateSourceWubi;
+  source_languages_["hybrid_auto_pinyin"] = kCandidateSourcePinyin;
+  LoadConfig();
+}
+
+void HybridFilter::LoadConfig() {
+  if (!engine_ || !engine_->schema())
+    return;
+  Config* config = engine_->schema()->config();
+  if (!config)
+    return;
+
+  config->GetString(name_space_ + "/tag", &tag_);
+  config->GetString(name_space_ + "/route_options/auto", &auto_option_);
+  config->GetString(name_space_ + "/route_options/wubi", &wubi_option_);
+  config->GetString(name_space_ + "/route_options/pinyin", &pinyin_option_);
+  config->GetBool(name_space_ + "/deduplicate", &deduplicate_);
+  config->GetBool(name_space_ + "/passthrough_unclassified",
+                  &passthrough_unclassified_);
+  int ranking_window = 0;
+  if (config->GetInt(name_space_ + "/ranking_window", &ranking_window) &&
+      ranking_window > 0) {
+    ranking_window_ = (std::min)(static_cast<size_t>(ranking_window),
+                                 static_cast<size_t>(256));
+  }
+
+  int source_mask = 0;
+  if (config->GetInt(name_space_ + "/candidate_source_masks/wubi",
+                     &source_mask) &&
+      source_mask != kCandidateSourceWubi) {
+    LOG(WARNING) << name_space_
+                 << "/candidate_source_masks/wubi must be 1; using 1.";
+  }
+  if (config->GetInt(name_space_ + "/candidate_source_masks/pinyin",
+                     &source_mask) &&
+      source_mask != kCandidateSourcePinyin) {
+    LOG(WARNING) << name_space_
+                 << "/candidate_source_masks/pinyin must be 2; using 2.";
+  }
+
+  LoadSourceTypes(config, name_space_ + "/wubi_candidate_types",
+                  kCandidateSourceWubi, &source_types_);
+  LoadSourceTypes(config, name_space_ + "/pinyin_candidate_types",
+                  kCandidateSourcePinyin, &source_types_);
+
+  if (auto source_languages =
+          config->GetMap(name_space_ + "/source_languages")) {
+    for (auto iter = source_languages->begin();
+         iter != source_languages->end(); ++iter) {
+      auto source = As<ConfigValue>(iter->second);
+      if (!source)
+        continue;
+      CandidateSourceMask source_mask = SourceMaskForName(source->str());
+      if (source_mask != kCandidateSourceNone) {
+        source_languages_[iter->first] = source_mask;
+      }
+    }
+  }
+}
+
+CandidateSourceMask HybridFilter::ClassifyCandidate(
+    const an<Candidate>& candidate) const {
+  CandidateSourceMask source_mask = kCandidateSourceNone;
+  for (const auto& genuine : Candidate::GetGenuineCandidates(candidate)) {
+    if (!genuine)
+      continue;
+    CandidateSourceMask genuine_source = kCandidateSourceNone;
+    if (auto phrase = As<Phrase>(genuine)) {
+      if (auto language = phrase->language()) {
+        auto source = source_languages_.find(language->name());
+        if (source != source_languages_.end()) {
+          genuine_source = source->second;
+        }
+      }
+    }
+    if (genuine_source == kCandidateSourceNone) {
+      auto type = source_types_.find(genuine->type());
+      if (type != source_types_.end()) {
+        genuine_source = type->second;
+      }
+    }
+    source_mask = MergeSourceMasks(source_mask, genuine_source);
+  }
+  return source_mask;
+}
+
+bool HybridFilter::Accepts(CandidateSourceMask source_mask) const {
+  CandidateSourceMask required = RequiredSourceMask();
+  if (required == kCandidateSourceNone)
+    return true;
+  return (static_cast<uint8_t>(source_mask) & static_cast<uint8_t>(required)) !=
+         0;
+}
+
+CandidateSourceMask HybridFilter::RequiredSourceMask() const {
+  switch (CurrentRoute()) {
+    case kWubiRoute:
+      return kCandidateSourceWubi;
+    case kPinyinRoute:
+      return kCandidateSourcePinyin;
+    default:
+      return kCandidateSourceNone;
+  }
+}
+
+HybridFilter::Route HybridFilter::CurrentRoute() const {
+  if (!engine_ || !engine_->context())
+    return kAutoRoute;
+  Context* context = engine_->context();
+  if (context->get_option(auto_option_))
+    return kAutoRoute;
+  if (context->get_option(wubi_option_))
+    return kWubiRoute;
+  if (context->get_option(pinyin_option_))
+    return kPinyinRoute;
+  return kAutoRoute;
+}
+
+bool HybridFilter::AppliesToSegment(Segment* segment) {
+  return segment && segment->HasTag(tag_);
+}
+
+an<Translation> HybridFilter::Apply(an<Translation> translation,
+                                    CandidateList*) {
+  if (!translation || translation->exhausted())
+    return translation;
+  return New<HybridFilterTranslation>(translation, this);
+}
+
+}  // namespace rime
