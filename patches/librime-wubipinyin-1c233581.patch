+//
+// Copyright RIME Developers
+// Distributed under the BSD License
+//
+
+#ifndef RIME_HYBRID_FILTER_H_
+#define RIME_HYBRID_FILTER_H_
+
+#include <stdint.h>
+#include <rime/filter.h>
+
+namespace rime {
+
+enum CandidateSourceMask : uint8_t {
+  kCandidateSourceNone = 0,
+  kCandidateSourceWubi = 1,
+  kCandidateSourcePinyin = 2,
+  kCandidateSourceBoth = kCandidateSourceWubi | kCandidateSourcePinyin,
+};
+
+class HybridCandidate : public UniquifiedCandidate {
+ public:
+  HybridCandidate(const an<Candidate>& item, CandidateSourceMask source_mask);
+
+  CandidateSourceMask source_mask() const { return source_mask_; }
+  void AddSourceMask(CandidateSourceMask source_mask);
+
+ private:
+  static const char* TypeForSourceMask(CandidateSourceMask source_mask);
+
+  CandidateSourceMask source_mask_;
+};
+
+class HybridFilterTranslation;
+
+class HybridFilter : public Filter {
+ public:
+  explicit HybridFilter(const Ticket& ticket);
+
+  virtual an<Translation> Apply(an<Translation> translation,
+                                CandidateList* candidates);
+  virtual bool AppliesToSegment(Segment* segment);
+
+ private:
+  friend class HybridFilterTranslation;
+
+  enum Route {
+    kAutoRoute,
+    kWubiRoute,
+    kPinyinRoute,
+  };
+
+  void LoadConfig();
+  CandidateSourceMask ClassifyCandidate(const an<Candidate>& candidate) const;
+  bool Accepts(CandidateSourceMask source_mask) const;
+  CandidateSourceMask RequiredSourceMask() const;
+  Route CurrentRoute() const;
+
+  string tag_ = "abc";
+  string auto_option_ = "hybrid_auto";
+  string wubi_option_ = "hybrid_wubi";
+  string pinyin_option_ = "hybrid_pinyin";
+  bool deduplicate_ = true;
+  bool passthrough_unclassified_ = true;
+  size_t ranking_window_ = 64;
+  map<string, CandidateSourceMask> source_types_;
+  map<string, CandidateSourceMask> source_languages_;
+};
+
+}  // namespace rime
+
+#endif  // RIME_HYBRID_FILTER_H_
