+
+  Language wubi("hybrid_auto_wubi");
+  Language pinyin("hybrid_auto_pinyin");
+  auto translation = New<FifoTranslation>();
+  translation->Append(MakePhrase(&pinyin, "phrase", "拼", 3.0));
+  translation->Append(MakePhrase(&wubi, "table", "五", 2.0));
+  translation->Append(New<SimpleCandidate>("punct", 0, 2, "，"));
+
+  CandidateList candidates;
+  vector<of<Candidate>> result =
+      Collect(filter.Apply(translation, &candidates), &candidates);
+
+  ASSERT_EQ(2U, result.size());
+  auto wubi_candidate = As<HybridCandidate>(result[0]);
+  ASSERT_TRUE(bool(wubi_candidate));
+  EXPECT_EQ(kCandidateSourceWubi, wubi_candidate->source_mask());
+  EXPECT_EQ("五", wubi_candidate->text());
+  EXPECT_EQ("punct", result[1]->type());
+}
