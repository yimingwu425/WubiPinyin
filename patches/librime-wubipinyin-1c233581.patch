+TEST(HybridFilterTest, LimitsInitialLookupToTheRankingWindow) {
+  Config* config = MakeConfig();
+  ASSERT_NE(nullptr, config);
+  the<Engine> engine(new HybridFilterTestEngine(config));
+  HybridFilter filter(Ticket(engine.get(), "hybrid"));
+
+  Language wubi("hybrid_auto_wubi");
+  auto translation = New<CountingTranslation>();
+  for (size_t index = 0; index < 65; ++index) {
+    translation->Append(MakePhrase(&wubi, "table",
+                                   "候" + std::to_string(index),
+                                   static_cast<double>(65 - index)));
+  }
+
+  CandidateList candidates;
+  auto filtered = filter.Apply(translation, &candidates);
+  ASSERT_TRUE(bool(filtered));
+  EXPECT_EQ(64U, translation->next_count);
+
+  for (size_t index = 0; index < 64; ++index) {
+    ASSERT_FALSE(filtered->exhausted());
+    ASSERT_TRUE(bool(filtered->Peek()));
+    filtered->Next();
+  }
+  EXPECT_EQ(64U, translation->next_count);
+  ASSERT_TRUE(bool(filtered->Peek()));
+  EXPECT_EQ(65U, translation->next_count);
+}
